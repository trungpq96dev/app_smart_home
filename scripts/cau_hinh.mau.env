# Cau hinh wifi_collector - CHEP RA .env ROI DIEN
#
#   cp cau_hinh.mau.env .env
#   nano .env
#   chmod 600 .env
#
# File .env that co mat khau router. Da nam trong .gitignore.

# --- Router TP-Link TL-WR840N ---
ROUTER_IP=192.168.0.1
ROUTER_USER=admin
# Mat khau dang nhap trang quan tri router (192.168.0.1). KHONG phai mat
# khau WiFi. TP-Link mac dinh admin/admin - neu da doi thi dien mat khau
# that. Sai mat khau thi script bao loi, khong khoa gi (khac EVN).
ROUTER_PASS=

# --- Mosquitto tren serverubuntu ---
# Trong container, 127.0.0.1 la chinh container - PHAI dung dia chi LAN cua
# server thi moi toi duoc Mosquitto.
MQTT_BROKER=192.168.0.50
MQTT_PORT=1883
# Dung chung tai khoan iot nhu dien_evn (lay tu ~/homeserver/.env).
MQTT_USER=iot
MQTT_PASS=

# Giay giua cac lan cao router.
POLL_INTERVAL=15

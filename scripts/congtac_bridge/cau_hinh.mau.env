# Cau hinh congtac_bridge - CHEP RA .env ROI DIEN
#
#   cp cau_hinh.mau.env .env
#   nano .env
#   chmod 600 .env
#
# File .env that co MAT KHAU MQTT va LOCAL_KEY cua den. Da nam trong
# .gitignore. Repo nay cong khai tren GitHub - dung commit .env.

# --- Mosquitto tren serverubuntu ---
# Trong container, 127.0.0.1 la chinh container - PHAI dung dia chi LAN cua
# server thi moi toi duoc Mosquitto. (Khac server_collector: no chay
# network_mode: host nen moi de 127.0.0.1 duoc.)
MQTT_BROKER=192.168.0.50
MQTT_PORT=1883
MQTT_USER=iot
MQTT_PASS=
# PHAI khac client id cua wifi_collector, server_collector va cua tablet.
# Trung id la broker da ca hai ra, va trieu chung nhin giong mat song.
MQTT_CLIENT_ID=smarthome-congtac-bridge

# --- Topic ---
TOPIC_GOC=congtac
# Topic lenh da ton tai san trong app (MqttDien.DieuKhienTopic.CMD).
TOPIC_LENH=smarthome/control

# --- Tu tim thiet bi khi DHCP doi IP ---
# Day la thu THAY CHO viec dat IP tinh tren router. Thiet bi mat dau thi
# bridge quet dai mang nay tim lai THEO MA CO DINH cua no (gwId cua Tuya,
# did cua CozyLife), roi tu cap nhat IP. Doi IP bao nhieu lan cung duoc.
#
# De RONG de tat tinh nang - luc do IP duoi day phai luon dung.
MANG=192.168.0.0/24
# Giay toi thieu giua hai lan quet. Thiet bi mat dien that thi khong nen
# quet lai moi vong poll: vua cham vua lam phien ca mang.
CHO_QUET=120

# --- Nhip ---
# 10s: duoi 5 thi Tuya bat dau de loi va CozyLife an connection slot; tren 15
# thi bam cong tac co xong nhin tablet thay sai toi 15 giay - dung thu lam
# nguoi dung mat tin vao man hinh.
POLL_INTERVAL=10
# De 3 chu dung 5-10: hai thiet bi chet cung luc thi moi vong poll dai them
# 2 x POLL_TIMEOUT.
POLL_TIMEOUT=3
# Giay: publish lai trang thai du khong doi, de retained luon tuoi.
LAM_MOI_RETAIN=60
# Bao nhieu vong loi LIEN TIEP moi tuyen bo mat ket noi (3 x 10s = 30s).
SO_LAN_LOI_OFFLINE=3

LOG_LEVEL=INFO

# --- Den: Smart Life / Tuya, TCP 6668 ---
# Dat 0 de bo qua han den - quat van chay. Dung khi chua lay duoc local_key.
DEN_BAT=1
DEN_ID=bed1_den
DEN_TEN=Đèn Phòng ngủ 1
DEN_PHONG=bed1
DEN_LOAI=den
# Chi la GOI Y - thu dia chi nay truoc cho nhanh. Sai thi bridge tu quet
# tim lai theo DEN_DEVICE_ID, khong can sua tay.
DEN_IP=192.168.0.100
# DANH TINH that cua den. Lay tu quang ba UDP 6667 - KHONG can tai khoan
# cloud nao. Xac minh luc quet: noi duoc bang device_id + local_key thi
# dung may (camera Tuya cung mo 6668 nhung khoa khac nen se truot).
DEN_DEVICE_ID=eb74553feb16595327lzam
# BI MAT. Chi lay duoc qua `python -m tinytuya wizard` mot lan. Doi moi lan
# ghep lai thiet bi - trieu chung khi do: noi duoc TCP nhung giai ma ra rac.
DEN_LOCAL_KEY=
# Lay tu quang ba, dung doan. Sai version thi treo toi timeout roi
# "No response" - rat giong loi mang.
DEN_VERSION=3.3
DEN_DP=1

# --- Quat: CozyLife, TCP 5555 ---
QUAT_BAT=1
QUAT_ID=bed1_quat
QUAT_TEN=Quạt Phòng ngủ 1
QUAT_PHONG=bed1
QUAT_LOAI=quat
# Chi la GOI Y, nhu DEN_IP.
QUAT_IP=192.168.0.103
QUAT_PORT=5555
# DANH TINH that cua quat (truong `did` trong tra loi cmd 0). BAT BUOC neu
# muon tu tim: cong 5555 cung la cong ADB cua Android, nen chi thay cong mo
# thi tuyet doi khong du de ket luan la dung may.
QUAT_DID=727700990050c2ecbf27
# Thiet bi khai HAI kenh attr [1, 2] (do 21/11/2026), khong phai mot nhu tai
# lieu goc giai dinh. DA CHOT: kenh 1 la quat - bat tat that ngay 21/11, quat
# quay roi dung. Kenh 2 la thu khac, khong dung toi.
QUAT_DPID=1
QUAT_GIA_TRI_BAT=255

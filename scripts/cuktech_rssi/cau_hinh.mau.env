# Cau hinh cuktech_rssi - CHEP RA .env ROI DIEN
#
#   cp cau_hinh.mau.env .env
#   nano .env
#   chmod 600 .env
#
# File .env that co MAT KHAU MQTT. Da nam trong .gitignore - dung commit.

# --- Mosquitto tren serverubuntu ---
# Script nay chay THANG tren server (khong Docker, vi no can D-Bus cua BlueZ),
# nen 127.0.0.1 la dung.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=iot
MQTT_PASS=
# PHAI khac client id cua cac collector khac. Trung id la broker da ca hai ra.
MQTT_CLIENT_ID=smarthome-cuktech-rssi

# --- Thiet bi ---
CUKTECH_MAC=3C:CD:73:2B:58:8A
BT_ADAPTER=hci0

# --- Danh tinh cua NOI DO ---
# Topic la `cuktech/rssi/<NGUON_ID>`, nen moi diem do mot id khac nhau thi app
# hien duoc ca hai cot cung luc. Day la cach so sanh "de dongle o server" voi
# "de ESP32 canh cu sac" ma khong phai doan.
NGUON_ID=server
NGUON_TEN=serverubuntu (dongle USB)

# --- Tu quet de lam tuoi so ---
# BlueZ XOA thuoc tinh RSSI khi thiet bi dang trong mot ket noi, nen dung luc
# noi duoc thi khong con so nao de doc. Script tu bat mot phien quet ngan khi
# so da cu hon QUET_CACH giay. Do thu: mot phien 8 giay khong lam rot ket noi
# dang co. Dat QUET_GIAY=0 de tat han (chi doc so do nguoi khac quet ra).
QUET_GIAY=6
QUET_CACH=60

# --- Nhip ---
# 20s la du: RSSI tren D-Bus chi doi khi BlueZ quet lai, va cai do khong nhanh
# hon the. Duoi 5 bi ep len 5.
NHIP=20

LOG_LEVEL=INFO

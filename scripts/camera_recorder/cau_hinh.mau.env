# ==============================================================================
# CẤU HÌNH MẪU CHO DỊCH VỤ CAMERA RECORDER 24/24 (serverubuntu 192.168.0.50)
# Sao chép thành `.env` rồi `chmod 600 .env` — KHÔNG đẩy `.env` lên Git.
# ==============================================================================

# --- 1. Kết nối go2rtc nội bộ ---
GO2RTC_HOST=127.0.0.1
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_TLS=0
GO2RTC_USER=
GO2RTC_PASS=
# Để trống CAMERAS= để dịch vụ tự lấy mọi luồng đang khai báo trong go2rtc.yaml,
# hoặc chỉ định rõ phân tách dấu phẩy, ví dụ: CAMERAS=cua_chinh,phong_khach
CAMERAS=

# --- 2. Ghi hình 24/24 & Bộ nhớ đệm Hot Cache (10 GB) ---
RECORDING_ENABLED=1
SEGMENT_SECONDS=600
AUDIO_CODEC=aac
LOCAL_CACHE_MAX_GB=10.0
LOCAL_EMERGENCY_MAX_GB=13.5
COLD_CACHE_MAX_GB=1.0

# --- 3. Google Drive 5TB cá nhân (@gmail.com) qua rclone ---
DRIVE_ENABLED=1
RCLONE_CONFIG=/config/rclone.conf
RCLONE_REMOTE=gdrive
DRIVE_ROOT=SmartHomeCamera
DRIVE_BWLIMIT=4M
DRIVE_RETENTION_DAYS=90

# --- 4. AI Phát hiện người nhẹ trên CPU (Motion Gate + YOLOv8n ONNX) ---
DETECT_PERSON_ENABLED=1
DETECT_FPS=2.0
DETECT_WIDTH=640
DETECT_HEIGHT=360
MOTION_DIFF_THRESH=20
MOTION_AREA_PCT=0.55
PERSON_CONF_THRESH=0.50
CONFIRM_FRAMES=2
EVENT_GAP_SEC=15
# Vùng canh chuẩn hóa x1,y1,x2,y2 (0..1). Để trống = toàn khung hình.
ROI_BOX=
ONNX_THREADS=2

# --- 5. Thông báo Telegram / ntfy khi phát hiện người hoặc người lạ ---
TG_ENABLED=1
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_COOLDOWN_SEC=45
OFFLINE_ALERT_MIN=10
# Tùy chọn dự phòng ntfy (ví dụ: https://ntfy.sh/smarthome-nha-ban)
NTFY_URL=

# --- 6. Nhận diện khuôn mặt YuNet + SFace (Mục 2.2 - nhẹ cho i5-3210M) ---
FACE_RECOGNITION_ENABLED=1
FACE_DIR=/data/faces
# Để trống = tự chạy trên tất cả luồng HD (bỏ qua hậu tố _sd)
FACE_CAMERAS=
FACE_POLL_SEC=1.5
FACE_MATCH_THRESH=0.363
FACE_GREET_COOLDOWN_SEC=1200
FACE_UNKNOWN_CONFIRM_SEC=2.5
FACE_UNKNOWN_CONFIRM_FRAMES=2
FACE_KNOWN_GRACE_SEC=300
FACE_UNKNOWN_RETENTION_DAYS=7
FACE_SLEEP_START_HOUR=23
FACE_SLEEP_END_HOUR=6

# --- 7. Mini-NVR Clip sự kiện (-c copy) & ONVIF PTZ / Riêng tư (Mục 2.3) ---
CLIP_ENABLED=1
CLIP_DURATION_SEC=25
CLIP_RETENTION_DAYS=14
# Chế độ mặc định khi khởi động: home | away | sleep
HOME_MODE=home
# Khai báo ONVIF cho từng cam bằng file /data/onvif_cameras.json hoặc chuỗi JSON tại đây:
ONVIF_CONFIG_PATH=/data/onvif_cameras.json
ONVIF_CAMERAS_JSON=

# --- 8. Cổng HTTP Playback API cho Tablet SmartHomeApp ---
API_HOST=0.0.0.0
API_PORT=1985
# Để trống thì tự dùng chung GO2RTC_USER / GO2RTC_PASS ở mục 1
API_USER=
API_PASS=

# --- 7. MQTT Mosquitto (lấy mật khẩu từ ~/server_collector/.env dòng MQTT_PASS) ---
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=iot
MQTT_PASS=
MQTT_TOPIC_GOC=camera

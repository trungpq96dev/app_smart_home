# Cau hinh server_collector - CHEP RA .env ROI DIEN
#
#   cp cau_hinh.mau.env .env
#   nano .env
#   chmod 600 .env
#
# File .env co mat khau MQTT va token dieu khien Docker. Da nam trong .gitignore.

# --- Mosquitto tren serverubuntu ---
# network_mode: host nen 127.0.0.1 chinh la Mosquitto tren host.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
# Dung chung tai khoan iot nhu dien_evn / wifi (lay tu ~/homeserver/.env).
MQTT_USER=iot
MQTT_PASS=

# Giay giua cac lan do (metrics). Docker + CPU%/RAM moi container cap nhat moi
# DOCKER_POLL_EVERY chu ky (mac dinh 3 * 5s = 15s).
POLL_INTERVAL=5
DOCKER_POLL_EVERY=3

# --- Dieu khien Bat/Tat container an toan (HTTP Bearer Auth, KHONG qua MQTT) ---
# Mac dinh TAT. Muon bat nut Start/Stop/Restart tu SmartHome Web:
#   1) Dat DOCKER_CONTROL_ENABLED=true
#   2) Tao token ngau nhien (>= 16 ky tu): openssl rand -hex 24
#   3) Dien CUNG token nay vao file .env cua SmartHome Web (DOCKER_CONTROL_TOKEN)
#   4) Chi dien cac container DUOC PHEP dieu khien vao DOCKER_ALLOWED_CONTAINERS.
#      (Cac container loi mosquitto, server-collector, smarthome-web bi CAM CUNG
#       trong ma nguon, khong the ghi de tu .env.)
DOCKER_CONTROL_ENABLED=false
DOCKER_CONTROL_BIND=0.0.0.0
DOCKER_CONTROL_PORT=1986
DOCKER_CONTROL_TOKEN=
DOCKER_ALLOWED_CONTAINERS=camera-recorder,beszel,beszel-agent,smarthome-tunnel,smarthome-cockpit-tunnel,wifi-collector,dien-evn
# Tuy chon: them container bao ve bo sung (ngoai 3 container loi bat buoc)
# DOCKER_PROTECTED_CONTAINERS=congtac-bridge,go2rtc

# Thuong khong can doi:
# ROOTFS=/rootfs
# DOCKER_SOCK=/var/run/docker.sock

# Cau hinh Beszel (Hub + Agent) tren serverubuntu - CHEP RA .env ROI DIEN
#
#   cp cau_hinh.mau.env .env
#   chmod 600 .env
#
# File .env chua khoa cong khai/token ket noi Agent. Da nam trong .gitignore.

# Cong giao dien web Beszel Hub trong mang LAN
BESZEL_PORT=8090
APP_URL=http://192.168.0.50:8090
TZ=Asia/Ho_Chi_Minh

# Khoa cong khai SSH cua Hub (trich tu ./beszel_data/id_ed25519 sau lan chay dau
# hoac chon copy trong muc "Add System" tren giao dien web Hub)
KEY=

# Tuy chon: Universal Token (neu muon Agent tu dong dang ky he thong vao Hub)
TOKEN=

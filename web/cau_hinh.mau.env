# Cấu hình mẫu cho SmartHome Web Gateway
# Copy file này thành .env (chỉ dùng nội bộ, KHÔNG commit .env lên git)
# Hoặc có thể bỏ trống và cấu hình trực tiếp trên màn hình Cài đặt của web.

PORT=3000
WEB_PORT=3080
HOST=0.0.0.0

# Khóa mật khẩu khi truy cập từ xa qua 4G / Cloudflare Tunnel
# (Bỏ qua đăng nhập khi đang ở trực tiếp trong WiFi nội bộ 192.168.x.x nếu WEB_AUTH_BYPASS_LAN=true)
WEB_ACCESS_PASS=
WEB_AUTH_BYPASS_LAN=true

# MQTT Broker
MQTT_HOST=192.168.0.50
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USER=iot
MQTT_PASS=
MQTT_CLIENT_ID=

# go2rtc Camera Server & Đầu ghi 24/24
GO2RTC_HOST=192.168.0.50
GO2RTC_PORT=1984
CAMERA_RECORDER_PORT=1985
GO2RTC_TLS=false
GO2RTC_USER=
GO2RTC_PASS=

# Open-Meteo Weather
WEATHER_NAME=Hà Nội
WEATHER_LAT=21.0278
WEATHER_LON=105.8342

# AquaControl Web URL (tùy chọn)
AQUACONTROL_URL=

# Bo bơm nước ESP32 AquaControl (tùy chọn — có thể cấu hình trên web)
# LƯU Ý: KHÔNG commit file .env chứa IP/mật khẩu thật lên Git!
BOMNUOC_ESP_HOST=
BOMNUOC_PREFER_LAN=true
BOMNUOC_MQTT_HOST=
BOMNUOC_MQTT_PORT=8883
BOMNUOC_MQTT_TLS=true
BOMNUOC_MQTT_USER=
BOMNUOC_MQTT_PASS=

# Cảnh báo khẩn ra Telegram (tùy chọn — có thể cấu hình trên web)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OFFLINE_MINUTES=5
TELEGRAM_ELECTRIC_SPIKE_PCT=40
TELEGRAM_ELECTRIC_SPIKE_MIN_KWH=3
TELEGRAM_GAS_THRESHOLD_PPM=200
TELEGRAM_COOLDOWN_MINUTES=30

# Topic cảm biến hành lang PIR & cảm biến Gas (tùy chọn)
PIR_MQTT_TOPIC=smarthome/sensor/pir
GAS_MQTT_TOPIC=smarthome/sensor/gas

# Khóa PIN 4 số cho khu vực Kỹ thuật (mặc định 1234 — nên đổi trên Web)
ADMIN_PIN_ENABLED=true
ADMIN_PIN=1234

# Điều khiển bật/tắt Docker container an toàn (gọi HTTP API riêng của server-collector, KHÔNG qua MQTT)
# Để bật nút Start/Stop/Restart trên màn Server: điền cùng token >= 16 ký tự với ~/server_collector/.env
DOCKER_CONTROL_HOST=192.168.0.50
DOCKER_CONTROL_PORT=1986
DOCKER_CONTROL_TOKEN=




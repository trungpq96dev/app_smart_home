# Cấu hình mẫu cho SmartHome Web Gateway
# Copy file này thành .env (chỉ dùng nội bộ, KHÔNG commit .env lên git)
# Hoặc có thể bỏ trống và cấu hình trực tiếp trên màn hình Cài đặt của web.

PORT=3000
HOST=0.0.0.0

# MQTT Broker
MQTT_HOST=192.168.0.50
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USER=iot
MQTT_PASS=
MQTT_CLIENT_ID=

# go2rtc Camera Server
GO2RTC_HOST=192.168.0.50
GO2RTC_PORT=1984
GO2RTC_TLS=false
GO2RTC_USER=
GO2RTC_PASS=

# Open-Meteo Weather
WEATHER_NAME=Hà Nội
WEATHER_LAT=21.0278
WEATHER_LON=105.8342

# AquaControl Web URL (tùy chọn)
AQUACONTROL_URL=

